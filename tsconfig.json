{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitepress/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "site/**/*.ts",
    "site/**/*.mts",
    "site/**/*.vue",
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
